{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "version": "1.9.5",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "unlimitedStorage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extTitle__"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_permissions": [
    "webRequest",
    "webNavigation",
    "history",
    "downloads"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "timemachine.html"
  }
}